# EvidenceLab corre 100% offline: no hay API keys.
# Estas variables solo ajustan la app al equipo donde se demuestra.

# Modelo servido por Ollama. Bajar a llama3.2:1b si la RAM aprieta (M1 de 8 GB).
EVIDENCELAB_OLLAMA_MODEL=llama3.2:3b
EVIDENCELAB_OLLAMA_HOST=http://127.0.0.1:11434

# Embeddings. multilingual-e5-small (471 MB) si hace falta liberar memoria.
EVIDENCELAB_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Re-ranker: apagarlo baja ~500 MB de RAM a costa de precisión.
EVIDENCELAB_USE_RERANKER=true

# Dispositivo de cómputo para embeddings y re-ranking. Se detecta solo:
# mps en Apple Silicon, cuda si hay GPU NVIDIA, cpu en lo demás.
# Fijarlo a cpu si MPS diera resultados extraños.
# EVIDENCELAB_DEVICE=cpu

# Retrieval
EVIDENCELAB_CHUNK_CANDIDATES=20
EVIDENCELAB_FINAL_CONTEXT_CHUNKS=6

EVIDENCELAB_ENVIRONMENT=development
EVIDENCELAB_LOG_LEVEL=INFO
